APP_NAME=PY Learning Project
ANTHROPIC_API_KEY=
DEBUG=false
CHAT_MODEL=claude-3-5-sonnet-latest
LLM_TIMEOUT=30.0
MODEL_PATH=./model.joblib
SUPABASE_URL=
SUPABASE_KEY=

# Only used by GET /health's SQLite ping (app/api/routes/health.py) — unrelated
# to Supabase, which is reached via SUPABASE_URL/SUPABASE_KEY above instead.
DATABASE_URL=sqlite:///./app.db

# --- Q&A history: /chat + /mida-assistant log each answered turn to the
# Supabase table `qa_logs` (app/db/qa_log.py, migration
# supabase/migrations/0002_create_qa_logs.sql). Uses SUPABASE_URL/KEY above;
# a write failure never breaks the response, it falls back to logs/errors.jsonl.

# --- LLM provider switch: app.llm.provider.get_llm_client() reads this ---
# "anthropic" (default, uses ANTHROPIC_API_KEY/CHAT_MODEL above) or "openrouter"
LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
